# Скопируй в .env и подставь свой ключ: cp .env.example .env
# Ключ OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# HF-режим (опционально): токен Hugging Face для локальной NLI-модели
# HF_TOKEN=hf_...

# --- Настройки детектора (precision-tuning, см. app/models.py) ---
# Модель детектора (по умолчанию google/gemini-2.5-flash)
# OPENROUTER_MODEL=google/gemini-2.5-flash
# Число прогонов self-consistency (>1 включает majority-голосование, режет ложные срабатывания)
# DETECTION_RUNS=3
# Температура прогонов (нужна >0 при DETECTION_RUNS>1, иначе прогоны идентичны)
# DETECTION_TEMPERATURE=0.4
# Доля прогонов, в которых категория должна встретиться, чтобы пройти (0..1)
# VOTE_RATIO=0.5
# Verifier-проход: второй LLM-вызов опровергает каждый флаг (1=вкл)
# VERIFIER_ENABLED=1
